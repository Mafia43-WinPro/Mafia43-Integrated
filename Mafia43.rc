IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Mafia43 정보"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,21,20
    LTEXT           "Mafia43, 버전 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2025",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "확인",IDOK,113,41,50,14,WS_GROUP
END

IDD_MAFIA43_DIALOG DIALOGEX 0, 0, 200, 256
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    CONTROL         IDB_BACKGROUND_MAIN,IDC_PIC_BACKGROUND,"Static",SS_BITMAP,0,0,192,244
    CONTROL         "",IDC_LIST_PLAYERS_IN_ROOM,"SysListView32",LVS_REPORT | LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,96,7,97,50
    EDITTEXT        IDC_EDIT_ROOM_TITLE,49,220,40,14,ES_AUTOHSCROLL
    PUSHBUTTON      "서버 접속",IDC_BUTTON_START,97,219,39,14
    PUSHBUTTON      "나가기",IDC_BUTTON_EXIT,148,219,39,14
    LTEXT           "서버 접속 대기 중...",IDC_STATIC_ROOMCODE,7,194,79,8
    PUSHBUTTON      "방 만들기",IDC_BTN_CREATE_ROOM,97,194,50,14
    PUSHBUTTON      "방 입장",IDC_BTN_JOIN_ROOM,94,168,50,14
    PUSHBUTTON      "게임 시작",IDC_BTN_START_GAME,93,139,50,14
    EDITTEXT        IDC_EDIT_NICKNAME,7,220,40,14,ES_AUTOHSCROLL | ES_READONLY
    CONTROL         "",IDC_LIST_PLAYERS,"SysListView32",LVS_REPORT | LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,7,63,179,52
END

